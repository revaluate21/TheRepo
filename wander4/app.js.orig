import {VERSION,TZ,fmtTime,fmtDate,parts,localAt,distance,distanceText,durationText,mapsURL,searchURL,streetURL,nodesFor,assess,weatherAt,weatherIcon,nearestIndex} from './logic.js';
import {icon} from './icons.js';
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const store={get(k,f=null){try{return JSON.parse(localStorage.getItem('wander4-'+k))??f}catch{return f}},set(k,v){try{localStorage.setItem('wander4-'+k,JSON.stringify(v));return true}catch{return false}}};
let D,PH,G,map=null,marker=null,circle=null,watch=null,installEvent=null,saveBusy=false,photoIndex=0,sheetReturn=null,routeMarkers=[];
const S={when:store.get('when','now'),mood:'all',search:'',gps:null,gpsWanted:false,weather:store.get('weather'),favorites:new Set(store.get('favorites',[])),progress:store.get('progress',{}),home:store.get('home'),downloads:store.get('downloads',[]),current:null,screen:'explore',lastHash:null};
const safeURL=u=>{try{const x=new URL(u);return ['https:','http:'].includes(x.protocol)?x.href:'#'}catch{return '#'}};
const btn=(action,label,ico='arrow',cls='outline-button',extra='')=>`<button class="${cls}" data-action="${action}" ${extra}>${icon(ico)}${label}</button>`;
const link=(url,label,ico='external',cls='outline-button')=>`<a class="${cls}" href="${esc(safeURL(url))}" target="_blank" rel="noopener">${icon(ico)}${label}</a>`;
const img=(key,alt,full=false,eager=false)=>{const p=PH[key];return p?`<img src="./${esc(full?p.src:p.thumb)}" alt="${esc(alt)}" loading="${eager?'eager':'lazy'}" data-thumb="./${esc(p.thumb)}" decoding="async" ${eager?'fetchpriority="high"':''}>`:`<div class="error-photo">Photo unavailable</div>`};
const routeBy=id=>D.routes.find(r=>r.id===id);
const geo=r=>G[r.id]||{legs:[],walkKm:null,verified:false};
const score=r=>assess(r,D.cities[r.city],S.weather,S.when,S.gps);
const photoPlaces=r=>r.stops.map(k=>D.places[k]);
const kmText=r=>geo(r).walkKm!=null?`${geo(r).walkKm.toFixed(1)} km${geo(r).verified?'':'+'}`:'Distance pending';
function toast(text){$('#toast').textContent=text;$('#toast').classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('#toast').classList.remove('show'),4200);}
function saveState(){store.set('favorites',[...S.favorites]);store.set('progress',S.progress);store.set('when',S.when);}
function connection(){const e=$('#connection');e.classList.toggle('offline',!navigator.onLine);e.textContent=navigator.onLine?'':'Offline';}
function credit(key){const p=PH[key];return p?`<p class="credit">Photo: <a href="${esc(safeURL(p.source))}" target="_blank" rel="noopener">${esc(p.author||p.title)}</a> · ${esc(p.license)} · resized / cropped for display.</p>`:'';}
function openSheet(content){sheetReturn=document.activeElement;$('#sheetContent').innerHTML=content;if(!$('#sheet').open)$('#sheet').showModal();$('#sheet').scrollTop=0;$('#closeSheet').focus();}
function closeSheet(){if($('#sheet').open)$('#sheet').close();sheetReturn?.focus?.();}
function currentView(){const raw=location.hash.slice(1);if(!raw)return {page:'explore'};if(raw==='saved'||raw==='plan'||raw==='explore')return {page:raw};const q=new URLSearchParams(raw);if(q.has('walk'))return {page:'walk',id:q.get('walk')};if(q.has('route'))return {page:'route',id:q.get('route')};if(q.has('city'))return {page:'city',id:q.get('city')};return {page:'explore'};}
function disposeMap(){if(map){map.remove();map=null;}marker=null;circle=null;routeMarkers=[];}
function showTabs(page){$('#bottomTabs').classList.toggle('hidden',page==='route'||page==='walk');$('#actionDock').classList.add('hidden');$$('[data-tab]').forEach(a=>a.classList.toggle('active',a.dataset.tab===page));}
function setDock(html){$('#actionDock').innerHTML=html;$('#actionDock').classList.remove('hidden');}
function heading(title,sub=''){return `<div class="section-heading"><h2>${title}</h2>${sub?`<span class="caption">${sub}</span>`:''}</div>`;}
function whenControl(){return `<label class="when-control">${icon('clock')}<select id="when" aria-label="When you want to leave"><option value="now" ${S.when==='now'?'selected':''}>Leave now</option><option value="morning" ${S.when==='morning'?'selected':''}>Tomorrow morning</option><option value="sunset" ${S.when==='sunset'?'selected':''}>Go for sunset</option></select></label>`;}
function card(r,{featured=false}={}){const a=score(r),city=D.cities[r.city];if(featured)return `<a class="featured" href="#route=${r.id}" aria-label="Explore ${esc(r.title)}">${img(r.hero,r.title,true,true)}<div class="featured-content"><span class="tag">${icon(a.tone==='good'?'sun':'clock')}${esc(a.label)}</span><h2>${esc(r.title)}</h2><p>${esc(city.name)} · ${esc(r.subtitle)}</p><div class="feature-stats"><span>${icon('clock')}${durationText(r.visitHours)} outing</span><span>${icon('walk')}${kmText(r)}</span>${a.weather?.temp!=null?`<span>${weatherIcon(a.weather.code,a.day)} ${Math.round(a.weather.temp)}° at arrival</span>`:''}</div><span class="featured-cta">${icon('arrow')}</span></div></a>`;
 return `<a class="route-card" href="#route=${r.id}" aria-label="Explore ${esc(r.title)}"><div class="card-image">${img(r.hero,r.title)}<span class="tag">${icon(r.when.includes('night')?'moon':'sun')}${esc(a.label)}</span></div><div class="card-copy"><div class="eyebrow">${esc(city.name)} · ${esc(r.moods.slice(0,2).join(' / '))}</div><h3>${esc(r.title)}</h3><p><span>${durationText(r.visitHours)} outing</span><span>${kmText(r)}</span></p></div></a>`;}
function renderExplore(cityId=null,saved=false){
 const city=D.cities[cityId];let rs=D.routes.filter(r=>(!city||r.city===city.id)&&(!saved||S.favorites.has(r.id))&&(S.mood==='all'||r.moods.includes(S.mood)));
 if(S.search){const q=S.search.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');rs=rs.filter(r=>`${r.title} ${D.cities[r.city].name} ${r.subtitle} ${r.moods.join(' ')}`.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').includes(q));}
 rs.sort((a,b)=>score(b).score-score(a).score);
 const title=saved?'Keep the good ones.':city?`${city.name}, differently.`:'Go somewhere<br>different.';
 const subtitle=saved?'Your saved walks. No account needed.':city?city.tag:'See the whole walk. Let Maps handle the turns.';
 const moods=[['all','All moods','map'],['quiet','Quiet','leaf'],['water','By water','wave'],['fantasy','Storybook','castle'],['night','After dark','moon']];
 let body=`<div class="page"><div class="intro"><div><div class="eyebrow">${saved?'YOUR LITTLE COLLECTION':'PORTUGAL · PHOTO-FIRST WALKS'}</div><h1>${title}</h1><p>${esc(subtitle)}</p></div>${whenControl()}</div>${city?`<a class="back" href="#explore">${icon('back')}All places</a>`:''}<div class="filter-row">${moods.map(([id,n,ic])=>`<button class="pill ${S.mood===id?'active':''}" data-action="mood" data-value="${id}" aria-pressed="${S.mood===id}">${icon(ic)}${n}</button>`).join('')}</div>`;
 if(rs.length){
  body+=`<div class="home-top">${card(rs[0],{featured:true})}${rs.length>1?`<div class="route-grid">${rs.slice(1,3).map(r=>card(r)).join('')}</div>`:''}</div>`;
  if(rs.length>3)body+=`${heading(city?'More ways to wander':'More worlds to wander',`${rs.length} curated walks`)}<div class="route-grid">${rs.slice(3).map(r=>card(r)).join('')}</div>`;
 }else body+=`<div class="empty">${icon('save')}<h2>${saved?'Nothing saved yet':'Try another mood'}</h2><p>${saved?'Tap the bookmark on any walk to keep it here.':'Change your filters to see more walks.'}</p><a class="solid-button" href="#explore">Explore walks ${icon('arrow')}</a></div>`;
 if(!city&&!saved){body+=`${heading('Choose a place',`${Object.keys(D.cities).length} different atmospheres`)}<div class="city-grid">${Object.values(D.cities).map(c=>`<a class="city-card" href="#city=${c.id}">${img(c.hero,c.name)}<strong>${esc(c.name)}</strong></a>`).join('')}</div>`;}
 body+=`<p class="help-line">${icon('info')}<span>Suggestions use arrival-time estimates from Loures${S.gps?' or your nearby GPS location':''}. ${S.weather?'Forecasts are not live conditions.':'Weather unavailable? Timing still works.'} Always check the last journey home.</span></p><div class="route-footer">${btn('locate','Use my location','locate')}${btn('sources','Sources & photo credits','photo')}</div></div>`;
 $('#main').innerHTML=body;
}
function weatherPanel(r){const a=score(r),w=a.weather;return `<div class="weather-score"><span class="weather-symbol">${weatherIcon(w?.code,a.day)}</span><div><strong>${esc(a.label)}</strong><p>${esc(D.cities[r.city].name)} · arrival ~${fmtTime(a.arrival)}</p></div></div><div class="weather-details">${w?`<span>${Math.round(w.temp)}°C</span><span>Feels ${Math.round(w.feels??w.temp)}°</span><span>${w.rain??'—'}% rain</span><span>${Math.round(w.wind??0)} km/h wind</span>`:'<span>Forecast unavailable — no weather assumed.</span>'}</div><p class="weather-time">${fmtDate(a.arrival)} · ${w?`Open-Meteo forecast · ${w.stale?'cached':'updated'} ${fmtTime(new Date(w.fetched))}`:'Daylight-based suggestion only'}${!navigator.onLine?' · offline':''}</p><p class="advice ${a.tone==='good'?'good':''}">${esc(a.reason)}</p><div class="daylight-badge">${icon('train')}~${durationText(a.travel/60)} to start · planning estimate</div>${w?.sunset?`<div class="daylight-badge">${icon('sunset')}Sunset ${fmtTime(new Date(w.sunset))}</div>`:''}<button class="mini-link" data-action="conditions">Time, weather & access ${icon('chevron')}</button>`;}
function mapHTML(r){return `<div class="map-card"><div class="map-head"><strong>Your whole journey</strong><div class="map-controls"><button class="icon-button" data-action="fit" aria-label="Show full journey">${icon('expand')}</button><button class="icon-button" data-action="locate" aria-label="Show my location">${icon('locate')}</button></div></div><div id="journeyMap" class="journey-map" role="region" aria-label="Interactive full route map for ${esc(r.title)}"></div><div id="mapWarning" class="map-note ${navigator.onLine?'hidden':''}">Offline map: route and pins remain; street tiles need a connection.</div><div class="map-caption"><span><i></i>Walking preview</span>${r.transfers.length?'<span><i class="transit"></i>Transport transfer</span>':''}<span>Tap a numbered stop</span></div></div>`;}
function renderRoute(r){S.current=r;const favorite=S.favorites.has(r.id),places=photoPlaces(r),g=geo(r);document.title=`${r.title} · Wander`;
 $('#main').innerHTML=`<div class="page route-page"><div class="route-tools"><a class="back" href="#city=${r.city}">${icon('back')}${esc(D.cities[r.city].name)}</a><div>${btn('favorite','', 'save','icon-button',`aria-label="${favorite?'Unsave':'Save'} walk" aria-pressed="${favorite}"`)}${btn('share','','share','icon-button','aria-label="Share this walk"')}</div></div><section class="hero">${img(r.hero,r.title,true,true)}<button class="hero-source" data-action="heroPhoto">${icon('photo')} Real place photo</button><div class="hero-copy"><div class="eyebrow">${esc(D.cities[r.city].name)}, Portugal</div><h1>${esc(r.title)}</h1><p>${esc(r.subtitle)}</p></div></section><div class="photo-strip" aria-label="Photos of the different stops">${places.filter(p=>p.photo!==r.hero).map(p=>`<button data-action="place" data-id="${p.id}" aria-label="View ${esc(p.name)}">${img(p.photo,p.name)}<span>${esc(p.name)}</span></button>`).join('')}</div><div class="route-meta"><div>${icon('clock')}<span>${durationText(r.visitHours)}<small>including visits</small></span></div><div>${icon('walk')}<span>${kmText(r)}<small>mapped walking</small></span></div><div>${icon('route')}<span>${esc(r.terrain)}<small>${r.transfers.length?'includes transfers':`${r.stops.length} places to discover`}</small></span></div></div><div class="route-layout">${mapHTML(r)}<aside class="side-card" id="conditionsPanel">${weatherPanel(r)}</aside></div>${heading('What you’ll see',`${places.length} different places`)}<div class="stop-list">${places.map((p,i)=>`<button class="stop-card" data-action="place" data-id="${p.id}"><div class="stop-photo">${img(p.photo,p.name)}<span class="stop-marker">${i+1}</span></div><div class="stop-copy"><strong>${esc(p.name)}</strong><p>${esc(p.cue)}</p>${p.ticket?'<span class="ticket-chip">Interior / grounds may need tickets</span>':''}</div></button>`).join('')}</div><div class="route-footer">${btn('transport','Getting there & home','train')}${btn('saveOffline',S.downloads.includes(r.id)?'Saved offline':'Save this walk','download')}${btn('join','Join near me','locate')}${btn('detours','Nearby ideas','map')}</div><p class="help-line">${icon('info')}<span>${esc(r.caution)}</span></p><p class="caption" style="margin-top:12px">${g.verified?'Walking lines follow mapped pedestrian paths, not compass bearings.':'Some legs are unverified and shown dashed.'} Signs, gates and temporary closures always take priority. Google Maps may choose a different accessible path.</p><div class="route-footer">${btn('gpx','Export route outline','download')}${btn('sources','Sources & credits','photo')}</div></div>`;
 setDock(`${btn('start',S.progress[r.id]?'Continue walk':'Start walk','play','solid-button')}${btn('transport','Get there','train','outline-button')}`);initMap(r);
}
function progressFor(r){const ns=nodesFor(r,D.places);let v=S.progress[r.id]||{i:0,done:[],started:Date.now()};v.i=Math.max(0,Math.min(Number(v.i)||0,ns.length-1));if(!Array.isArray(v.done))v.done=[];return v;}
function renderFocus(r){S.current=r;const ns=nodesFor(r,D.places),pr=progressFor(r);S.progress[r.id]=pr;saveState();const n=ns[pr.i],leg=geo(r).legs.find(l=>l.end===n.id),transfer=leg?.mode==='transit';const completed=pr.complete===true;const done=pr.done.length;
 document.title=`${n.name} · Wander`;
 if(completed){$('#main').innerHTML=`<div class="page focus-page"><a class="back" href="#route=${r.id}">${icon('back')}Whole journey</a><div class="empty" style="margin-top:24px">${icon('check')}<h1>Well wandered.</h1><p>${esc(r.title)}<br>${done} stops marked · ${kmText(r)} mapped route</p>${btn('transport','Find my way home','home','solid-button')}<div class="route-footer">${btn('restart','Walk again','undo')}<a class="outline-button" href="#explore">Explore more</a></div></div></div>`;setDock(btn('transport','Journey home','home','solid-button'));return;}
 const nav=mapsURL(n,transfer?'transit':'walking');
 $('#main').innerHTML=`<div class="page focus-page"><div class="focus-heading"><a class="back" href="#route=${r.id}">${icon('back')}Whole journey</a><p>${pr.i+1} / ${ns.length}</p></div><div class="progress" aria-label="Route progress"><div style="width:${Math.round(pr.i/ns.length*100)}%"></div></div><div class="focus-card">${n.anchor?`<div class="anchor-art">${icon(n.id==='finish'?'home':'train')}<span>${n.id==='finish'?'RETURN POINT':'START POINT'}</span></div>`:img(n.photo,n.name,true,true)}<span class="tag">${icon(transfer?'train':n.anchor?'pin':'walk')}${transfer?'Transport transfer':n.anchor?(n.id==='finish'?'The finish':'Get to the start'):'Your next place'}</span>${!n.anchor?btn('place','','photo','icon-button photo-open',`data-id="${n.id}" aria-label="Photo and details of ${esc(n.name)}"`):''}</div><div class="focus-title"><h1>${esc(n.name)}</h1><p>${esc(n.cue)}</p></div><p id="focusStatus" class="focus-status">${S.gps?`${distanceText(distance(S.gps,n))} straight-line proximity · GPS ±${Math.round(S.gps.acc)} m`:'No compass guessing. Maps handles the actual streets.'}</p><div class="focus-note">${icon(transfer?'train':'headphones')}<span><strong>${transfer?'Use the transport link for this leg.':'Open Maps, tap Start, then put the phone away.'}</strong><br>${transfer?'This gap is not marked as a walking route.':'Come back here at the landmark and tap “I’m here”.'}${!navigator.onLine?' Google walking / transit directions need data.':''}</span></div><div class="focus-controls">${btn('previous','Back','back','outline-button',pr.i===0?'disabled':'')}${btn('arrived',n.id==='finish'?'Finish walk':'I’m here','check','solid-button')}${btn('skip','Skip','arrow','outline-button')}</div><div class="focus-linkbar">${btn('join','Join nearby','locate','text-button')}${btn('transport','Home / transit','home','text-button')}${btn('locate','My position','locate','text-button')}</div><p class="caption" style="margin-top:18px">Maps guides one leg at a time. Wander does not monitor you or announce turns while your phone is locked.</p></div>`;
 setDock(link(nav,`<span class="button-label">${transfer?'Find transport':'Navigate with Google Maps'}<small>${transfer?'Bus / public transport planner':'Walking directions · one leg at a time'}</small></span>`,transfer?'train':'play','solid-button'));
}
function renderPlan(){const blurbs=['The first proper taste of old Lisbon.','A forest-and-palace day: book the interior you most want.','Slow down by the Atlantic.','Trade the capital for university courtyards and river calm.','Templar stone followed by woodland and river light.'];$('#main').innerHTML=`<div class="page"><div class="intro"><div><div class="eyebrow">FIVE DIFFERENT WORLDS</div><h1>Make the days<br>feel different.</h1><p>A suggested mix, not a timetable. Swap the order for weather and tickets.</p></div></div><div class="plan-list">${D.plan.map((id,i)=>{const r=routeBy(id);return `<article class="plan-card">${img(r.hero,r.title)}<div class="plan-copy"><div class="eyebrow">DAY ${i+1} · ${esc(D.cities[r.city].name)}</div><h2>${esc(r.title)}</h2><p>${blurbs[i]}</p><a href="#route=${id}">See this walk ${icon('arrow')}</a></div></article>`}).join('')}</div><p class="help-line">${icon('info')}Long walks are optional, not a daily quota. Allow rest, travel and time to actually look around.</p></div>`;}
function render(keepScroll=false){if(!D)return;const v=currentView();const previousScroll=scrollY;disposeMap();S.screen=v.page;S.current=null;showTabs(v.page);document.title='Wander · Portugal, on foot';if(v.page==='route'||v.page==='walk'){const r=routeBy(v.id);if(r){v.page==='route'?renderRoute(r):renderFocus(r);}else{location.hash='explore';return;}}else if(v.page==='plan')renderPlan();else renderExplore(v.page==='city'?v.id:null,v.page==='saved');if(keepScroll)scrollTo(0,previousScroll);else scrollTo({top:0,behavior:'instant'});connection();}
function initMap(r){if(!window.L){$('#journeyMap').innerHTML='<div class="error-photo">Map could not load. The stop list and Google Maps buttons still work.</div>';return;}map=L.map('journeyMap',{scrollWheelZoom:false,zoomControl:false,minZoom:5,maxZoom:19});L.control.zoom({position:'bottomleft'}).addTo(map);const tiles=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);let errors=0;
 tiles.on('tileerror',()=>{if(++errors>=2){const e=$('#mapWarning');if(e){e.textContent='Street background unavailable. The route and place pins still work.';e.classList.remove('hidden');}}});
 const geometry=geo(r);geometry.legs.forEach(l=>{const walking=l.mode==='walk';if(l.points?.length>1){L.polyline(l.points,{color:walking?'#fff':'#536faf',weight:walking?8:3,opacity:1,dashArray:walking?null:'6 7'}).addTo(map);if(walking)L.polyline(l.points,{color:'#f4438d',weight:4,opacity:.94}).addTo(map);}});
 if(!geometry.legs.length)L.polyline([r.start,...photoPlaces(r),r.end].map(p=>[p.lat,p.lon]),{color:'#536faf',weight:3,dashArray:'6 8'}).addTo(map);
 photoPlaces(r).forEach((p,i)=>{const m=L.marker([p.lat,p.lon],{icon:L.divIcon({className:'',html:`<span class="stop-marker">${i+1}</span>`,iconSize:[29,29],iconAnchor:[14,14]}),title:p.name,zIndexOffset:100+i}).addTo(map).on('click',()=>placeSheet(p.id));routeMarkers.push(m);});
 const anchor=(p,text)=>L.marker([p.lat,p.lon],{icon:L.divIcon({className:'',html:`<span class="anchor-marker">${text}</span>`,iconSize:[85,30],iconAnchor:[-12,32]}),zIndexOffset:-50}).addTo(map).bindPopup(esc(p.name));
 anchor(r.start,distance(r.start,r.end)<40?'Start / finish':'Start');if(distance(r.start,r.end)>=40)anchor(r.end,'Finish');fitMap();updateMapGPS(false);
}
function fitMap(){if(!map||!S.current)return;const r=S.current;const pts=geo(r).legs.flatMap(l=>l.points||[]);pts.push([r.start.lat,r.start.lon],[r.end.lat,r.end.lon],...photoPlaces(r).map(p=>[p.lat,p.lon]));map.fitBounds(L.latLngBounds(pts),{padding:[35,35],maxZoom:16,animate:false});setTimeout(()=>map?.invalidateSize(),120);}
function updateMapGPS(pan=false){if(!map||!S.gps)return;const g=S.gps;if(!marker){marker=L.marker([g.lat,g.lon],{icon:L.divIcon({className:'',html:'<span class="puck"></span>',iconSize:[18,18],iconAnchor:[9,9]}),zIndexOffset:1000,title:'Your position'}).addTo(map);circle=L.circle([g.lat,g.lon],{radius:Math.min(g.acc,500),color:'#1d6ee0',weight:1,fillOpacity:.08}).addTo(map);}else{marker.setLatLng([g.lat,g.lon]);circle.setLatLng([g.lat,g.lon]).setRadius(Math.min(g.acc,500));}if(pan)map.setView([g.lat,g.lon],16);}
function placeSheet(id){const p=D.places[id];if(!p)return;const r=S.current;const i=r?.stops.indexOf(id);if(map&&i>=0){routeMarkers.forEach((m,n)=>m.setZIndexOffset(n===i?600:100+n));}
 openSheet(`${img(p.photo,p.name,true,true).replace('<img ','<img class="sheet-image" ')}<div class="sheet-body"><div class="eyebrow">${r&&i>=0?`STOP ${i+1} · `:''}${p.ticket?'CHECK TICKETS / ACCESS':'A PLACE TO PAUSE'}</div><h2 id="sheetTitle">${esc(p.name)}</h2><p><strong>${esc(p.cue)}</strong></p><p>${esc(p.about)}</p><div class="sheet-actions">${btn('photo','Full photograph','photo','outline-button',`data-key="${p.photo}" data-name="${esc(p.name)}"`)}${link(streetURL(p),'Look around in Street View','map')}</div><div class="sheet-actions">${r?btn('chooseStop','Make this my next stop','pin','solid-button',`data-id="${p.id}"`):''}${link(searchURL(`${p.name}, Portugal`),'Place in Maps','external')}</div>${p.source?`<a class="source-link" href="${esc(safeURL(p.source))}" target="_blank" rel="noopener">Official visitor information</a>`:''}${credit(p.photo)}</div>`);
}
function photoSheet(key,name='Photograph'){openSheet(`<div>${img(key,name,true,true).replace('<img ','<img class="sheet-fullphoto" ')}</div><div class="sheet-body"><h2 id="sheetTitle">${esc(name)}</h2>${credit(key)}</div>`);}
function conditionsSheet(){const r=S.current;if(!r)return;const a=score(r);openSheet(`<div class="sheet-body"><h2 id="sheetTitle">A good time to go?</h2>${whenControl()}<div style="margin-top:18px">${weatherPanel(r).replace(/<button class="mini-link"[\s\S]*?<\/button>/,'')}</div><div class="small-notice">${esc(r.caution)}</div><p>Arrival and outing times are planning estimates, not live transit or opening-hours guarantees. Weather is for ${esc(D.cities[r.city].name)}, not your phone’s location.</p>${link(r.source||D.cities[r.city].links[0][1],'Check current access','external')}<a class="source-link" href="https://open-meteo.com/" target="_blank" rel="noopener">Weather: Open-Meteo, CC BY 4.0</a></div>`);}
function transportSheet(){const r=S.current||routeBy('lisbon-classic'),c=D.cities[r.city],h=S.home||{text:'2660-213 Santo António dos Cavaleiros, Portugal'};const home=h.text||`${h.lat},${h.lon}`;
 openSheet(`<div class="sheet-body"><div class="eyebrow">GET THERE · ENJOY IT · GET HOME</div><h2 id="sheetTitle">${esc(c.name)}, without a car</h2><h3>${icon('train')} Going</h3>${c.there.map(t=>`<div class="transport-step"><p>${esc(t)}</p></div>`).join('')}<div class="sheet-actions">${link(mapsURL(r.start,'transit',null,false),'From me → walk start','train','solid-button')}${link(mapsURL(r.start,'transit',home,false),'From home → start','home')}</div><h3>${icon('home')} Coming back</h3>${c.back.map(t=>`<div class="transport-step"><p>${esc(t)}</p></div>`).join('')}<div class="sheet-actions">${link(mapsURL(home,'transit',null,false),'From me → home','home','solid-button')}${link(mapsURL(r.end,'walking'),'Walk → return stop','walk')}</div><p class="caption">Home: ${esc(h.text||h.label||'Your saved private location')}. Set this in Settings. It is never included in shared links.</p><div class="small-notice">Check the <strong>last connection all the way home</strong>, not only the first train. No static bus times are treated as live arrivals.</div><div class="detail-list">${c.links.map(([n,u])=>`<a href="${esc(safeURL(u))}" target="_blank" rel="noopener">${esc(n)} · official planner ${icon('external')}</a>`).join('')}</div></div>`);
}
function detoursSheet(){const r=S.current||routeBy('lisbon-classic');const near=Object.values(D.places).filter(p=>!r.stops.includes(p.id)&&distance(p,r.start)<17000).sort((a,b)=>distance(a,r.start)-distance(b,r.start)).slice(0,5);
 openSheet(`<div class="sheet-body"><div class="eyebrow">ONLY IF THE MOOD TAKES YOU</div><h2 id="sheetTitle">A little further</h2><p>Optional ideas, not extra compulsory stops. Check access and your return before detouring.</p>${r.extra?`<div class="small-notice">${esc(r.extra)}</div>`:''}<div class="detail-list">${near.map(p=>`<button data-action="detourPlace" data-id="${p.id}"><span>${esc(p.name)}<br><small class="muted">${esc(p.cue)}</small></span>${icon('chevron')}</button>`).join('')}</div>${r.city==='lisbon'?`<h3>Something completely different</h3><div class="detail-list"><a href="https://zenius-i-vanisher.com/v5.2/arcade.php?id=8795&section=summary" target="_blank" rel="noopener"><span>Four-arrow dance arcade<br><small class="muted">Tropical Time · community listing, verify cabinet first</small></span>${icon('external')}</a><a href="https://ra.co/events/pt/lisbon" target="_blank" rel="noopener"><span>Electronic music tonight<br><small class="muted">Current listings, not a cached “live” event</small></span>${icon('external')}</a></div>`:''}</div>`);
}
function settingsSheet(){const h=S.home;openSheet(`<div class="sheet-body"><div class="eyebrow">WANDER ${VERSION}</div><h2 id="sheetTitle">Make it yours.</h2><div class="detail-list"><button data-action="install"><span>Install / add to home screen</span>${icon('download')}</button><button data-action="locate"><span>Allow my location</span>${icon('locate')}</button><button data-action="sources"><span>Photo credits & sources</span>${icon('photo')}</button></div><label class="home-field">Your home / return area<input id="homeInput" type="text" maxlength="200" placeholder="Postcode, town or station" value="${esc(h?.text||'2660-213 Santo António dos Cavaleiros, Portugal')}"></label><div class="sheet-actions">${btn('saveHome','Save home','check','solid-button')}${btn('homeGPS','Use GPS here','locate')}</div><p class="caption">Home, favourites and progress stay in this browser. No account or analytics. Map and weather providers receive normal requests; opening Maps sends your chosen destination to Google.</p><h3>Phone down, honestly.</h3><p>Wander shows the places and the complete route. Google Maps speaks directions for each leg after you tap Start there. Return to Wander at each landmark. This browser app does not give locked-screen turn-by-turn directions.</p><h3>Offline</h3><p>Saved walk photos, place cards and route outlines work offline. Street-map backgrounds, fresh weather, live transport and Google Maps walking directions still need a connection. GPS also requires device permission.</p><p class="caption">Keep one ear aware of traffic and your surroundings. A charged phone and a checked return matter more than a step target.</p><div class="detail-list"><button data-action="refreshWeather">Refresh weather ${icon('cloud')}</button><button data-action="clearDownloads">Remove saved photo downloads ${icon('download')}</button></div></div>`);}
function sourcesSheet(){const r=S.current;const keys=[...new Set(r?[r.hero,...photoPlaces(r).map(p=>p.photo)]:Object.keys(PH))];openSheet(`<div class="sheet-body"><h2 id="sheetTitle">Real places. Real photographs.</h2><p>Photos are stored with the app, not fragile external image links. All are credited below. They show the named places, but are not live images.</p>${r?`<a class="source-link" href="${esc(safeURL(r.source))}" target="_blank" rel="noopener">Visitor information for this walk</a>`:''}<p class="caption">Mapped routes: OpenStreetMap contributors; pedestrian route geometry prepared with Valhalla. Changes to paths, closures and gates must be checked locally. Travel durations and visit durations are estimates.</p><a class="source-link" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap copyright</a><a class="source-link" href="https://open-meteo.com/" target="_blank" rel="noopener">Weather: Open-Meteo</a>${keys.map(k=>`<h3>${esc(PH[k]?.title||k)}</h3>${credit(k)}`).join('')}</div>`);}
async function getGPS(){if(!navigator.geolocation)throw Error('Location is unavailable in this browser. Manual stops and Maps still work.');return new Promise((resolve,reject)=>navigator.geolocation.getCurrentPosition(p=>resolve({lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy,time:p.timestamp}),e=>reject(Error(e.code===1?'Location denied. Allow Location in Chrome site settings, or choose your stop manually.':e.code===3?'Location timed out. Try outdoors, or choose your stop manually.':'Location unavailable. Manual navigation still works.')),{enableHighAccuracy:true,timeout:15000,maximumAge:10000}));}
function onGPS(g){S.gps=g;updateMapGPS(false);const status=$('#focusStatus');if(status&&S.current){const ns=nodesFor(S.current,D.places),n=ns[progressFor(S.current).i];status.textContent=`${distanceText(distance(g,n))} straight-line proximity · GPS ±${Math.round(g.acc)} m`;}}
function startWatch(){if(watch!==null||!S.gpsWanted||document.hidden||!navigator.geolocation)return;watch=navigator.geolocation.watchPosition(p=>onGPS({lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy,time:p.timestamp}),()=>{stopWatch();S.gpsWanted=false;},{enableHighAccuracy:true,maximumAge:12000,timeout:20000});}
function stopWatch(){if(watch!==null){navigator.geolocation.clearWatch(watch);watch=null;}}
async function locate(){try{toast('Finding your position…');const g=await getGPS();onGPS(g);S.gpsWanted=true;startWatch();if(map)updateMapGPS(true);else if(['explore','city','saved'].includes(S.screen))render(true);toast(`Location ready · accuracy ±${Math.round(g.acc)} m`);}catch(e){toast(e.message);}}
async function join(){if(!S.current)return;try{toast('Finding a sensible starting point…');const g=await getGPS();onGPS(g);const ns=nodesFor(S.current,D.places),best=nearestIndex(ns,g);if(best.m>15000)throw Error('You are not near this walk yet. Use Get there first.');if(g.acc>150)throw Error('Location is too imprecise. Choose the stop manually from the map.');const n=ns[best.i];openSheet(`<div class="sheet-body"><h2 id="sheetTitle">Join at ${esc(n.name)}?</h2><p>${distanceText(best.m)} straight-line proximity. This skips earlier stops only after you confirm.</p><div class="sheet-actions">${btn('joinConfirm','Start here','check','solid-button',`data-index="${best.i}"`)}${btn('close','Keep my place','back')}</div></div>`);}catch(e){toast(e.message);}}
function chooseIndex(i){const r=S.current,ns=nodesFor(r,D.places),pr=progressFor(r);pr.i=Math.max(0,Math.min(i,ns.length-1));pr.complete=false;S.progress[r.id]=pr;saveState();closeSheet();if(S.screen==='walk')render(true);else location.hash=`walk=${r.id}`;}
function advance(skip=false){const r=S.current,ns=nodesFor(r,D.places),pr=progressFor(r);if(!skip&&!pr.done.includes(ns[pr.i].id))pr.done.push(ns[pr.i].id);if(pr.i===ns.length-1)pr.complete=true;else pr.i++;S.progress[r.id]=pr;saveState();render();}
async function downloadWalk(){const r=S.current;if(!r||saveBusy)return;if(!navigator.onLine){toast('Connect once to save this walk’s photos.');return;}if(!('caches'in window)){toast('Offline saving is not supported here.');return;}saveBusy=true;const keys=[...new Set([r.hero,...photoPlaces(r).map(p=>p.photo)])];const urls=keys.flatMap(k=>PH[k]?[PH[k].src,PH[k].thumb]:[]);openSheet(`<div class="sheet-body"><h2 id="sheetTitle">Save the whole picture.</h2><p id="downloadStatus">Saving ${urls.length} images for ${esc(r.title)}…</p><div class="offline-progress"><div id="downloadProgress" style="width:0"></div></div><p class="caption">Place cards and route outlines are also saved. Street maps and Google navigation are not downloaded.</p></div>`);let good=0;
 try{const cache=await caches.open('wander4-photos-v1');for(const rel of urls){const url=new URL(rel,location.href).href;const hit=await cache.match(url);if(!hit){const resp=await fetch(url);if(!resp.ok||!resp.headers.get('content-type')?.startsWith('image/'))throw Error('An image could not be saved. Retry while connected.');await cache.put(url,resp);}good++;if($('#downloadProgress'))$('#downloadProgress').style.width=`${Math.round(good/urls.length*100)}%`;}
  if(!S.downloads.includes(r.id))S.downloads.push(r.id);store.set('downloads',S.downloads);if($('#downloadStatus'))$('#downloadStatus').textContent='Ready offline: photos, place cards and route outline.';toast('Walk saved for offline browsing.');
 }catch(e){if($('#downloadStatus'))$('#downloadStatus').textContent=e.message;toast(e.message);}finally{saveBusy=false;}
}
function exportGPX(){const r=S.current;if(!r)return;const g=geo(r);let xml=`<?xml version="1.0" encoding="UTF-8"?><gpx version="1.1" creator="Wander" xmlns="http://www.topografix.com/GPX/1/1"><metadata><name>${esc(r.title)}</name><desc>Pedestrian preview. Transport gaps are separate; obey local access restrictions.</desc></metadata>`;photoPlaces(r).forEach(p=>xml+=`<wpt lat="${p.lat}" lon="${p.lon}"><name>${esc(p.name)}</name></wpt>`);xml+=`<trk><name>${esc(r.title)}</name>`;g.legs.filter(l=>l.mode==='walk').forEach(l=>{xml+='<trkseg>'+l.points.map(([lat,lon])=>`<trkpt lat="${lat}" lon="${lon}"/>`).join('')+'</trkseg>';});xml+='</trk></gpx>';const u=URL.createObjectURL(new Blob([xml],{type:'application/gpx+xml'}));const a=document.createElement('a');a.href=u;a.download=`wander-${r.id}.gpx`;a.click();setTimeout(()=>URL.revokeObjectURL(u),2000);}
async function refreshWeather(force=false){if(!navigator.onLine)return;if(!force&&S.weather&&Date.now()-S.weather.fetched<1800000)return;const cities=Object.values(D.cities);const u=new URL('https://api.open-meteo.com/v1/forecast');u.searchParams.set('latitude',cities.map(c=>c.lat).join(','));u.searchParams.set('longitude',cities.map(c=>c.lon).join(','));u.searchParams.set('hourly','temperature_2m,apparent_temperature,precipitation_probability,weather_code,wind_speed_10m');u.searchParams.set('daily','sunrise,sunset');u.searchParams.set('timezone',TZ);u.searchParams.set('timeformat','unixtime');u.searchParams.set('forecast_days','7');
 try{const res=await fetch(u,{signal:AbortSignal.timeout(10000)});if(!res.ok)throw Error('Forecast not available');let data=await res.json();if(!Array.isArray(data))data=[data];const bundle={fetched:Date.now(),data:{}};cities.forEach((c,i)=>{if(!data[i]?.hourly?.time)throw Error('Incomplete forecast');bundle.data[c.id]=data[i];});S.weather=bundle;store.set('weather',bundle);if(['explore','city','saved'].includes(S.screen))render(true);else if(S.screen==='route'&&$('#conditionsPanel'))$('#conditionsPanel').innerHTML=weatherPanel(S.current);if(force)toast('Forecast updated.');
 }catch{if(force)toast('Weather unavailable. No weather is assumed.');}
}
async function share(){const u=new URL(location.href);u.search='';u.hash=S.current?`route=${S.current.id}`:'explore';try{if(navigator.share)await navigator.share({title:S.current?.title||'Wander Portugal',url:u.href});else{await navigator.clipboard.writeText(u.href);toast('Route link copied. Private home details are not shared.');}}catch(e){if(e.name!=='AbortError')openSheet(`<div class="sheet-body"><h2 id="sheetTitle">Share this walk</h2><label class="home-field">Copy this link<input readonly value="${esc(u.href)}" onclick="this.select()"></label></div>`);}}
async function install(){if(installEvent){await installEvent.prompt();installEvent=null;return;}openSheet(`<div class="sheet-body"><h2 id="sheetTitle">Keep Wander on your phone.</h2><p><strong>Android Chrome:</strong> open the browser menu, then choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.</p><p><strong>iPhone Safari:</strong> Share → Add to Home Screen.</p><p>Open it online once. Save a walk to keep its photos offline. Maps still handles directions separately.</p></div>`);}
async function actions(e){const el=e.target.closest('[data-action]');if(!el)return;const act=el.dataset.action,r=S.current;
 switch(act){
 case 'mood':S.mood=el.dataset.value;render(true);break;
 case 'favorite':if(!r)return;if(S.favorites.has(r.id))S.favorites.delete(r.id);else S.favorites.add(r.id);saveState();el.setAttribute('aria-pressed',String(S.favorites.has(r.id)));el.setAttribute('aria-label',S.favorites.has(r.id)?'Unsave walk':'Save walk');el.style.color=S.favorites.has(r.id)?'var(--purple)':'';toast(S.favorites.has(r.id)?'Saved to your walks.':'Removed from saved walks.');break;
 case 'start':if(r){if(!S.progress[r.id])S.progress[r.id]={i:0,done:[],started:Date.now()};saveState();location.hash=`walk=${r.id}`;}break;
 case 'place':case 'detourPlace':placeSheet(el.dataset.id);break;
 case 'photo':photoSheet(el.dataset.key,el.dataset.name);break;
 case 'heroPhoto':if(r)photoSheet(r.hero,photoPlaces(r).find(p=>p.photo===r.hero)?.name||r.title);break;
 case 'chooseStop':if(r){const ns=nodesFor(r,D.places);chooseIndex(ns.findIndex(n=>n.id===el.dataset.id));}break;
 case 'arrived':advance();break;case 'skip':advance(true);break;
 case 'previous':if(r){chooseIndex(Math.max(0,progressFor(r).i-1));}break;
 case 'restart':if(r){S.progress[r.id]={i:0,done:[],started:Date.now()};saveState();render();}break;
 case 'joinConfirm':chooseIndex(Number(el.dataset.index));break;
 case 'transport':transportSheet();break;case 'conditions':conditionsSheet();break;
 case 'share':await share();break;case 'install':await install();break;
 case 'locate':await locate();break;case 'join':await join();break;case 'fit':fitMap();break;
 case 'saveOffline':await downloadWalk();break;case 'gpx':exportGPX();break;
 case 'sources':sourcesSheet();break;case 'detours':detoursSheet();break;case 'close':closeSheet();break;
 case 'saveHome':{const v=$('#homeInput')?.value.trim();if(!v){toast('Enter a postcode, town or station.');return;}S.home={text:v};store.set('home',S.home);toast('Home saved only on this device.');break;}
 case 'homeGPS':try{const g=await getGPS();S.home={lat:g.lat,lon:g.lon,label:'My private saved location'};store.set('home',S.home);toast('Home saved privately from GPS.');}catch(err){toast(err.message);}break;
 case 'refreshWeather':await refreshWeather(true);break;
 case 'clearDownloads':await caches.delete('wander4-photos-v1');S.downloads=[];store.set('downloads',[]);toast('Saved full-size photos removed; basic app cache retained.');break;
 }
}
function bind(){document.addEventListener('click',actions);$('#menuButton').innerHTML=icon('menu');$('#menuButton').addEventListener('click',settingsSheet);$('#closeSheet').addEventListener('click',closeSheet);$('#sheet').addEventListener('click',e=>{if(e.target===$('#sheet')){const b=e.target.getBoundingClientRect();if(e.clientX<b.left||e.clientX>b.right||e.clientY<b.top||e.clientY>b.bottom)closeSheet();}});
 document.addEventListener('change',e=>{if(e.target.id==='when'){S.when=e.target.value;saveState();const wasSheet=$('#sheet').open;render(true);if(wasSheet&&S.current)conditionsSheet();}});
 document.addEventListener('error',e=>{if(e.target instanceof HTMLImageElement&&e.target.hasAttribute('data-thumb')&&!e.target.dataset.failed){if(e.target.dataset.thumb&&!e.target.dataset.fallback&&e.target.src!==new URL(e.target.dataset.thumb,location.href).href){e.target.dataset.fallback='1';e.target.src=e.target.dataset.thumb;return;}e.target.dataset.failed='1';const f=document.createElement('span');f.className='error-photo';f.textContent='Photo unavailable · retry online';e.target.replaceWith(f);}},true);
 document.addEventListener('visibilitychange',()=>{if(document.hidden)stopWatch();else startWatch();});
 window.addEventListener('hashchange',()=>{closeSheet();render();});window.addEventListener('online',()=>{connection();refreshWeather();});window.addEventListener('offline',()=>{connection();const note=$('#mapWarning');if(note)note.classList.remove('hidden');});
 window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();installEvent=e;});
 $$('.bottom-tabs a').forEach(a=>{const which={explore:'map',saved:'save',plan:'calendar'}[a.dataset.tab];a.innerHTML=icon(which)+a.textContent;});
}
async function init(){try{[D,PH,G]=await Promise.all(['catalog.json','photos.json','geometry.json'].map(async f=>{const r=await fetch('./'+f);if(!r.ok)throw Error(`Could not load ${f}`);return r.json();}));bind();render();refreshWeather();
 if('serviceWorker'in navigator){navigator.serviceWorker.register('./sw.js',{scope:'./'}).then(reg=>{reg.update().catch(()=>{});}).catch(()=>{});}
 window.Wander={version:VERSION,data:D,photos:PH,geometry:G,state:S,render,assess:(id,selection='now',now=new Date())=>assess(routeBy(id),D.cities[routeBy(id).city],S.weather,selection,S.gps,now)};
 }catch(err){$('#main').innerHTML=`<div class="page"><div class="empty">${icon('info')}<h1>Let’s reconnect.</h1><p>The first load needs a connection. Nothing has been lost.</p><button class="solid-button" onclick="location.reload()">Try again</button></div></div>`;console.error(err);}}

init();
